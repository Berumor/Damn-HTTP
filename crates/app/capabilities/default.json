{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the main window may do: call the app's own commands. No filesystem, shell, HTTP or other plugin access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-workspace-pick-folder",
    "allow-workspace-create",
    "allow-workspace-open",
    "allow-workspace-close",
    "allow-workspace-current",
    "allow-workspace-recent",
    "allow-workspace-tree",
    "allow-collection-create",
    "allow-folder-create",
    "allow-request-create",
    "allow-node-rename",
    "allow-node-duplicate",
    "allow-node-move",
    "allow-node-delete"
  ]
}
